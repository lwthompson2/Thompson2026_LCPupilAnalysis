               <node>
                  <name>Posterior-stimulus-independent-response-limited</name>
                  <description>Limited to the stimulus train: Activity confined to or maximal at the back of the head and not at the flash frequency or at a harmonic thereof. The term includes delta and theta activity and frank epileptiform patterns.</description>
                  <attribute>
                     <name>suggestedTag</name>
                     <value>Feature-frequency</value>
                  </attribute>
                  <attribute>
                     <name>annotation</name>
                     <value>dc:source Trenite ea 2001</value>
