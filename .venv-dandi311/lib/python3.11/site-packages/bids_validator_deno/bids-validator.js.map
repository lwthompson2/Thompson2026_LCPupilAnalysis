            </attribute>
            <attribute>
               <name>inLibrary</name>
               <value>score</value>
            </attribute>
         </node>
         <node>
            <name>Slow-fused-transient</name>
            <description>A posterior slow-wave preceded by a sharp-contoured potential that blends together with the ensuing slow wave, in children.</description>
