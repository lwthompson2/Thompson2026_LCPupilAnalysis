            <name>requireChild</name>
         </attribute>
         <attribute>
            <name>inLibrary</name>
            <value>score</value>
         </attribute>
         <node>
            <name>Rhythmic-activity-pattern</name>
            <description>Not further specified.</description>
            <attribute>
               <name>suggestedTag</name>
               <value>Rhythmic-activity-morphology</value>
               <value>Brain-laterality</value>
